{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Monitora Pet",
  "version": "0.2.0",
  "identifier": "br.com.lucascode.monitorapet",
  "build": {
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../desktop/prepare_tauri_sidecar.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Monitora Pet",
        "url": "loading.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "category": "Utility",
    "copyright": "Copyright © 2026 Monitora Pet",
    "shortDescription": "Monitoramento local de pets com câmeras IP",
    "longDescription": "O Monitora Pet monitora localmente visitas de gatos às áreas de alimentação, água e caixa de areia usando câmeras IP.",
    "externalBin": [
      "binaries/monitorapet-backend"
    ],
    "icon": [
      "../../desktop/monitorapet.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
